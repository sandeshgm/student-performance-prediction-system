{
  "name": "student-performance-backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:local": "node scripts/runLocal.js",
    "dev": "nodemon server.js",
    "frontend": "npm run dev --prefix frontend",
    "seed:admin": "node scripts/seedAdmin.js",
    "backfill:students": "node scripts/backfillStudents.js",
    "ml:dataset": "node scripts/runPython.js ml/generate_dataset.py",
    "ml:train": "node scripts/runPython.js ml/train.py",
    "ml:setup": "npm run ml:dataset && npm run ml:train",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Student performance prediction API with a from-scratch decision tree",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14"
  }
}
